	"main": "dist/main.js",
	"scripts": {
		"postinstall": "patch-package --patch-dir build-patches --error-on-fail",
		"test:de-model": "tsx scripts/test-de-model.ts",
		"test:i18n": "node scripts/check-i18n.mjs",
		"test:preview-status": "tsx scripts/test-preview-status.ts",
