		"test:mod-34-migration": "tsx _irys/test-legacy-34-to-35.ts",
		"test:mod-baseline": "tsx _irys/test-mod-baseline.ts",
		"test:mod-delta-builder": "tsx _irys/test-mod-delta-builder.ts",
		"test:startup-telemetry": "tsx scripts/test-startup-telemetry-uploader.ts",
		"build:mod-delta": "tsx _irys/build-mod-delta.ts",
		"build:mod-baseline": "tsx _irys/build-mod-baseline.ts",
		"sign:mod-manifest": "tsx _irys/sign-mod-manifest.ts"
	},
	"electronmon": {
		"patterns": [
			"!**/**"
		],
		"logLevel": "quiet"
	},
