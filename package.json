		"dist:dmg": "node scripts/ensure-stormlib-thirdparty.cjs && npm run build && electron-builder --mac --publish never && npm run fix:mac && npm run sign:mac && npm run create:dmg",
		"fix:mac": "node scripts/fix-mac-app.js",
		"sign:mac": "node scripts/sign-mac-app.js",
		"create:dmg": "node scripts/create-dmg.js",
		"dev": "concurrently \"npm run start\" \"npm run electron\"",
		"prepare:terrain": "node scripts/prepare-terrain-assets.mjs",
		"build:terrain-slk": "node scripts/build-terrain-slk.mjs",
		"test:mod-update": "tsx scripts/test-mod-update-smoke.ts",
		"test:war3-detector-persistence": "tsx scripts/test-war3-detector-persistence.ts",
		"test:managed-resource-files": "tsx scripts/test-managed-resource-files.ts",
		"test:webui-asset-sync": "tsx scripts/test-webui-asset-sync.ts",
		"test:post-processing-config": "tsx scripts/test-post-processing-config.ts",
		"test:update-site": "node scripts/check-update-site.mjs",
