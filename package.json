		"pack": "tsx scripts/webpack.build production",
		"build": "tsx scripts/webpack.build production",
		"dist:win": "node scripts/ensure-stormlib-thirdparty.cjs && npm run build && electron-builder --win",
		"dist:mac": "node scripts/ensure-stormlib-thirdparty.cjs && npm run build && electron-builder --mac && npm run fix:mac && npm run sign:mac && npm run create:dmg",
